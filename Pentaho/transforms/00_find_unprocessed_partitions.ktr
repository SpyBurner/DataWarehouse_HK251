    </partitioning>
    <send_true_to>Check _SUCCESS exists</send_true_to>
    <send_false_to>Dummy discard</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>audit_extract_dt</leftvalue>
        <function>IS NULL</function>
        <rightvalue/>
      </condition>
    </compare>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
