  <step>
    <name>Loaded partitions from audit</name>
    <type>TableInput</type>
    <description>Read all extract_dt values that were successfully loaded, sorted for Merge Join</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>MSSQL_Staging</connection>
    <sql>SELECT extract_dt AS audit_extract_dt
FROM dbo.stg_load_audit
WHERE status = 'success'
ORDER BY audit_extract_dt</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta>
