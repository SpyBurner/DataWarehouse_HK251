  <step>
    <name>Check _SUCCESS exists</name>
    <type>ScriptValueMod</type>
    <description>Check whether _SUCCESS sentinel file exists in the partition folder</description>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>Y</compatible>
    <optimizationLevel/>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>ScriptValue</jsScript_name>
        <jsScript_script>
      
var landing_root = getVariable("LANDING_ROOT", "");
var full_partition_path = landing_root + "/extract_dt=" + folder_extract_dt;
var success_file = new java.io.File(full_partition_path + "/_SUCCESS");
var has_success = success_file.exists();
      
    </jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>has_success</name>
        <rename>has_success</rename>
        <type>Boolean</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>full_partition_path</name>
        <rename>full_partition_path</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
