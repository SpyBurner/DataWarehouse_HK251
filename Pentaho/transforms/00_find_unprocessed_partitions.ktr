  <step>
    <name>Merge Join</name>
    <type>MergeJoin</type>
    <description>LEFT OUTER join: folder list vs audit table on folder_extract_dt = audit_extract_dt</description>
    <distribute>N</distribute>
    <custom_distribution/>
