    <connection>MSSQL_Staging</connection>
    <sql>SELECT playerid, country, created
FROM (
    SELECT playerid, country, created,
           ROW_NUMBER() OVER(PARTITION BY playerid ORDER BY loaded_at DESC) as rn
    FROM dbo.stg_players
) sub
WHERE rn = 1</sql>
