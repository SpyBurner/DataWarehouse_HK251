<?xml version='1.0' encoding='UTF-8'?>
<transformation>
  <info>
    <name>20_build_postgres_dw_fact_achievement</name>
    <description>MSSQL stg_history → Postgres dw.fact_achievement_unlock (upsert)</description>
  </info>

  <connection>
    <name>MSSQL_Staging</name>
    <server>localhost</server>
    <type>MSSQLNATIVE</type>
    <access>Native</access>
    <database>DW_Staging</database>
    <port>1433</port>
    <username>sa</username>
    <password>31082004@Lmao</password>
    <attributes>
      <attribute><code>trustServerCertificate</code><attribute>true</attribute></attribute>
    </attributes>
  </connection>

  <connection>
    <name>Postgres_Warehouse</name>
    <server>localhost</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>Warehouse</database>
    <port>5432</port>
    <username>postgres</username>
    <password>31082004@Lmao</password>
  </connection>

  <step>
    
    <name>Table Input</name>
    <type>TableInput</type>
    <distribute>Y</distribute><custom_distribution /><copies>1</copies><partitioning><method>none</method><schema_name /></partitioning><connection>MSSQL_Staging</connection>
    <sql>SELECT playerid, achievementid, date_acquired, extract_dt
FROM dbo.stg_history</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <GUI><xloc>80</xloc><yloc>160</yloc><draw>Y</draw></GUI></step>

  <step>
    
    <name>Derive gameid</name>
    <type>ScriptValueMod</type>
    <distribute>Y</distribute><custom_distribution /><copies>1</copies><partitioning><method>none</method><schema_name /></partitioning><description>gameid = everything before the first underscore in achievementid</description>
    <script>
      
var parts = achievementid.toString().split("_");
var gameid = parts[0];  // appid is the first segment
      
    </script>
    <fields>
      <field>
        <name>gameid</name>
        <rename>gameid</rename>
        <type>String</type>
        <length>30</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <GUI><xloc>280</xloc><yloc>160</yloc><draw>Y</draw></GUI></step>

  <step>
    
    <name>Select Values</name>
    <type>SelectValues</type>
    <distribute>Y</distribute><custom_distribution /><copies>1</copies><partitioning><method>none</method><schema_name /></partitioning><select_unspecified>N</select_unspecified>
    <fields>
      <field><name>playerid</name></field>
      <field><name>achievementid</name></field>
      <field><name>gameid</name></field>
      <field><name>date_acquired</name></field>
      <field><name>extract_dt</name></field>
    </fields>
    <meta>
      <field>
        <name>date_acquired</name>
        <rename>date_acquired</rename>
        <type>Timestamp</type>
        <length>-1</length>
        <precision>-1</precision>
        <conversion_mask>yyyy-MM-dd HH:mm:ss</conversion_mask>
      </field>
    </meta>
    <GUI><xloc>480</xloc><yloc>160</yloc><draw>Y</draw></GUI></step>

  <step>
    
    <name>Insert Update</name>
    <type>InsertUpdate</type>
    <distribute>Y</distribute><custom_distribution /><copies>1</copies><partitioning><method>none</method><schema_name /></partitioning><connection>Postgres_Warehouse</connection>
    <schema>dw</schema>
    <table>fact_achievement_unlock</table>
    <commit>1000</commit>
    <lookup>
      <key><name>playerid</name>     <field>playerid</field>     <condition>=</condition><name2 /></key>
      <key><name>achievementid</name><field>achievementid</field><condition>=</condition><name2 /></key>
    </lookup>
    <values>
      <value><name>playerid</name>     <rename>playerid</rename>     <update>N</update></value>
      <value><name>achievementid</name><rename>achievementid</rename><update>N</update></value>
      <value><name>gameid</name>       <rename>gameid</rename>       <update>Y</update></value>
      <value><name>date_acquired</name><rename>date_acquired</rename><update>Y</update></value>
      <value><name>extract_dt</name>   <rename>extract_dt</rename>   <update>Y</update></value>
    </values>
    <GUI><xloc>680</xloc><yloc>160</yloc><draw>Y</draw></GUI></step>

  <order>
    <hop><from>Table Input</from>  <to>Derive gameid</to> <enabled>Y</enabled></hop>
    <hop><from>Derive gameid</from><to>Select Values</to> <enabled>Y</enabled></hop>
    <hop><from>Select Values</from><to>Insert Update</to> <enabled>Y</enabled></hop>
  </order>

<notepads /></transformation>