<?xml version='1.0' encoding='UTF-8'?>
<transformation>
  <info>
    <name>10_load_mssql_staging_players</name>
    <description>CSV → dbo.stg_players (MSSQL Staging)</description>
  </info>

  <connection>
    <name>MSSQL_Staging</name>
    <server>localhost</server>
    <type>MSSQLNATIVE</type>
    <access>Native</access>
    <database>DW_Staging</database>
    <port>1433</port>
    <username>sa</username>
    <password>31082004@Lmao</password>
    <attributes>
      <attribute><code>trustServerCertificate</code><attribute>true</attribute></attribute>
    </attributes>
  </connection>

  <step>
    
    <name>CSV File Input</name>
    <type>CsvInput</type>
    <distribute>Y</distribute><custom_distribution /><copies>1</copies><partitioning><method>none</method><schema_name /></partitioning><filename>${PARTITION_PATH}/players.csv</filename>
    <filename_field />
    <rownum_field />
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible_in_fields>N</newline_possible_in_fields>
    <fields>
      <field><name>playerid</name> <type>String</type><format /><currency /><decimal /><group /><length>30</length><precision>-1</precision><trim_type>none</trim_type></field>
      <field><name>country</name>  <type>String</type><format /><currency /><decimal /><group /><length>10</length><precision>-1</precision><trim_type>none</trim_type></field>
      <field><name>created</name>  <type>String</type><format /><currency /><decimal /><group /><length>30</length><precision>-1</precision><trim_type>none</trim_type></field>
    </fields>
    <GUI><xloc>80</xloc><yloc>160</yloc><draw>Y</draw></GUI><newline_possible>N</newline_possible><format>mixed</format><encoding /></step>

  <step>
    
    <name>Add constants</name>
    <type>GetVariable</type>
    <distribute>Y</distribute><custom_distribution /><copies>1</copies><partitioning><method>none</method><schema_name /></partitioning><fields>
      <field>
        <name>extract_dt</name>
        <type>String</type>
        <format />
        <currency />
        <decimal />
        <group />
        <length>50</length>
        <precision>-1</precision>
      <variable>${LATEST_PARTITION}</variable></field>
    </fields>
    <GUI><xloc>280</xloc><yloc>160</yloc><draw>Y</draw></GUI></step>

  <step>
    
    <name>Select Values</name>
    <type>SelectValues</type>
    <distribute>Y</distribute><custom_distribution /><copies>1</copies><partitioning><method>none</method><schema_name /></partitioning><fields>
      <field><name>playerid</name></field>
      <field><name>country</name></field>
      <field><name>created</name></field>
      <field><name>extract_dt</name></field>
    </fields>
    <GUI><xloc>480</xloc><yloc>160</yloc><draw>Y</draw></GUI></step>

  <step>
    
    <name>Table Output</name>
    <type>TableOutput</type>
    <distribute>Y</distribute><custom_distribution /><copies>1</copies><partitioning><method>none</method><schema_name /></partitioning><connection>MSSQL_Staging</connection>
    <schema>dbo</schema>
    <table>stg_players</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>N</specify_fields>
    <GUI><xloc>680</xloc><yloc>160</yloc><draw>Y</draw></GUI></step>

  <order>
    <hop><from>CSV File Input</from><to>Add constants</to> <enabled>Y</enabled></hop>
    <hop><from>Add constants</from><to>Select Values</to>  <enabled>Y</enabled></hop>
    <hop><from>Select Values</from><to>Table Output</to>   <enabled>Y</enabled></hop>
  </order>

<notepads /></transformation>