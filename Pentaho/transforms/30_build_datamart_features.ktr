  <step>
    <name>Branch A: Speed Features</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Postgres_Warehouse</connection>
    <sql>WITH valid_players AS (
    SELECT playerid FROM dw.dim_player WHERE is_private = FALSE
),
intervals AS (
    SELECT u.playerid,
           EXTRACT(EPOCH FROM (u.date_acquired - LAG(u.date_acquired) OVER (PARTITION BY u.playerid ORDER BY u.date_acquired))) AS interval_sec,
           date_trunc('minute', u.date_acquired) as acq_minute,
           date_trunc('day', u.date_acquired) as acq_day
    FROM dw.fact_achievement_unlock u
    JOIN valid_players p ON u.playerid = p.playerid
),
minute_counts AS (
    SELECT playerid, acq_minute, COUNT(*) as cnt FROM intervals GROUP BY playerid, acq_minute
),
max_minute_counts AS (
    SELECT playerid, MAX(cnt) as max_achievements_per_minute FROM minute_counts GROUP BY playerid
),
day_counts AS (
    SELECT playerid, acq_day, COUNT(*) as cnt FROM intervals GROUP BY playerid, acq_day
),
max_day_counts AS (
    SELECT playerid, MAX(cnt) as max_achievements_per_day FROM day_counts GROUP BY playerid
),
base_stats AS (
    SELECT 
        playerid,
        COALESCE(percentile_cont(0.5) WITHIN GROUP (ORDER BY interval_sec), 0) AS median_unlock_interval_sec,
        COALESCE(stddev_pop(interval_sec), 0) AS std_unlock_interval_sec,
        CASE WHEN avg(interval_sec) > 0 THEN stddev_pop(interval_sec) / avg(interval_sec) ELSE 0 END AS cv_unlock_interval
    FROM intervals
    GROUP BY playerid
)
SELECT 
    b.playerid,
    b.median_unlock_interval_sec,
    b.std_unlock_interval_sec,
    b.cv_unlock_interval,
    COALESCE(mm.max_achievements_per_minute, 0) AS max_achievements_per_minute,
    COALESCE(md.max_achievements_per_day, 0) AS max_achievements_per_day
FROM base_stats b
LEFT JOIN max_minute_counts mm ON b.playerid = mm.playerid
LEFT JOIN max_day_counts md ON b.playerid = md.playerid
ORDER BY b.playerid;</sql>
    <limit>0</limit>
    <lookup/>
