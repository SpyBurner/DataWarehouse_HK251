  <step>
    <name>Compute features</name>
    <type>ScriptValueMod</type>
    <description>Derive achievement_game_ratio and review_duplication_rate (placeholder)</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
