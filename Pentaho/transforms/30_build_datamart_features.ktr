  <step>
    <name>Branch E: Account Age Features</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Postgres_Warehouse</connection>
    <sql>SELECT 
    p.playerid,
    TRUNC(EXTRACT(EPOCH FROM (MIN(u.date_acquired) - p.created)) / 86400) AS days_before_first_achievement,
    TRUNC(EXTRACT(EPOCH FROM (NOW() - p.created)) / 86400) AS account_age_days
FROM dw.dim_player p
LEFT JOIN dw.fact_achievement_unlock u ON p.playerid = u.playerid
WHERE p.is_private = FALSE
GROUP BY p.playerid, p.created
ORDER BY p.playerid;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
