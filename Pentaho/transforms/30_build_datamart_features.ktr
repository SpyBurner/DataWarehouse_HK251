    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>ScriptValue</jsScript_name>
        <jsScript_script>
      
// achievement_game_ratio = total_achievements / library_size (avoid division by zero)
var achievement_game_ratio = 0.0;
if (library_size != null &amp;&amp; library_size > 0) {
    achievement_game_ratio = total_achievements / library_size;
}

// review_duplication_rate — placeholder; implement with a subquery or additional join later
var review_duplication_rate = 0.0;
      
    </jsScript_script>
      </jsScript>
    </jsScripts>
