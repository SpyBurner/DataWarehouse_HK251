  <step>
    <name>Branch D: Review Features</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Postgres_Warehouse</connection>
    <sql>SELECT 
    r.playerid,
    COUNT(r.reviewid) AS total_reviews,
    AVG(LENGTH(r.review)) AS avg_review_length,
    MIN(LENGTH(r.review)) AS min_review_length,
    COUNT(*) FILTER (WHERE l.playtime_mins = 0)::NUMERIC / NULLIF(COUNT(r.reviewid), 0) AS review_unplayed_ratio,
    1.0 - (COUNT(DISTINCT LOWER(TRIM(r.review)))::NUMERIC / NULLIF(COUNT(r.reviewid), 0)) AS review_duplication_rate
FROM dw.fact_review r
JOIN dw.dim_player p ON r.playerid = p.playerid
LEFT JOIN dw.fact_library l ON r.playerid = l.playerid AND r.gameid = l.appid
WHERE p.is_private = FALSE
GROUP BY r.playerid
ORDER BY r.playerid;</sql>
