    <connection>MSSQL_Staging</connection>
    <sql>SELECT playerid, friends
FROM (
    SELECT playerid, friends, ROW_NUMBER() OVER(PARTITION BY playerid ORDER BY loaded_at DESC) as rn
    FROM dbo.stg_friends
) sub
WHERE rn = 1</sql>
