2026/05/04 04:07:32 - Insert Fact Library - Running SQL :INSERT INTO dw.fact_library (playerid, appid, playtime_mins)
SELECT 
    playerid,
    -- Dynamically extract appid based on the JSON element type
    CASE 
        WHEN json_typeof(game_element) = 'object' THEN (game_element->>'appid')::int
        ELSE (game_element#>>'{}')::int 
    END as appid,
    -- Dynamically extract playtime, defaulting to 0 for the old format
    CASE 
        WHEN json_typeof(game_element) = 'object' THEN COALESCE((game_element->>'playtime_mins')::int, 0)
        ELSE 0 
    END as playtime_mins
FROM dw.stg_library_temp,
LATERAL json_array_elements(NULLIF(library, '')::json) AS game_element
WHERE library IS NOT NULL 
  AND library != '[]'
-- The Upsert Logic:
ON CONFLICT (playerid, appid) 
DO UPDATE SET 
    -- EXCLUDED represents the incoming row that caused the conflict
    playtime_mins = EXCLUDED.playtime_mins; 

-- Clean up the temporary staging table after successful insertion/update
TRUNCATE TABLE dw.stg_library_temp;
