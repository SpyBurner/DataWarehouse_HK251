SELECT 
    u.playerid,
    COUNT(u.achievementid) FILTER (WHERE l.playtime_mins = 0)::NUMERIC / NULLIF(COUNT(u.achievementid), 0) AS zero_playtime_achievements_ratio,
    SUM(l.playtime_mins) AS total_playtime_mins,
    SUM(l.playtime_mins)::NUMERIC / NULLIF(COUNT(u.achievementid), 0) AS playtime_per_achievement
FROM dw.fact_achievement_unlock u
LEFT JOIN dw.fact_achievement da ON u.achievementid = da.achievementid
LEFT JOIN unique_playtime l ON u.playerid = l.playerid AND da.gameid = l.appid
GROUP BY u.playerid
ORDER BY u.playerid;
