2026/05/04 07:11:45 - Branch E: Account Age Features.0 - SQL query : SELECT 
    p.playerid,
    TRUNC(EXTRACT(EPOCH FROM (MIN(u.date_acquired) - p.created)) / 86400) AS days_before_first_achievement,
    TRUNC(EXTRACT(EPOCH FROM (NOW() - p.created)) / 86400) AS account_age_days
FROM dw.dim_player p
LEFT JOIN dw.fact_achievement_unlock u ON p.playerid = u.playerid
WHERE p.is_private = FALSE
GROUP BY p.playerid, p.created
ORDER BY p.playerid;
